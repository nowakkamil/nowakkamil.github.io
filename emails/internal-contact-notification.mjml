<mjml lang="en" dir="ltr">
    <mj-head>
        <mj-title>New inquiry — nowakkamil.com</mj-title>
        <mj-preview>New portfolio inquiry from {{ customerName }}</mj-preview>

        <mj-attributes>
            <mj-all
                font-family="'Avenir Next', Avenir, 'Segoe UI', Helvetica, sans-serif"
                font-weight="400"
            />
            <mj-text color="#d9dee5" font-size="15px" line-height="26px" />
            <mj-section padding="0" />
            <mj-column padding="0" />
        </mj-attributes>

        <mj-style inline="inline">
            body {
                overflow-x: hidden !important;
            }

            .inquiry-surface {
                width: 100% !important;
                box-sizing: border-box !important;
                background-color: #02050a !important;
            }

            .inquiry-surface > table {
                width: 100% !important;
                table-layout: fixed !important;
                background-color: #02050a !important;
            }

            .inquiry-email a {
                color: #159bb0 !important;
                text-decoration: none !important;
                -webkit-text-fill-color: #159bb0 !important;
            }
        </mj-style>

        <mj-style>
            @media only screen and (max-width: 480px) {
                .mobile-gutter {
                    padding-left: 24px !important;
                    padding-right: 24px !important;
                }

                .inquiry-name {
                    padding-top: 24px !important;
                    font-size: 24px !important;
                    line-height: 30px !important;
                }
            }
        </mj-style>

        <mj-raw>
            <meta name="color-scheme" content="dark" /> <meta name="supported-color-schemes"
            content="dark" />
        </mj-raw>
    </mj-head>

    <mj-body width="632px" background-color="#03070d">
        <mj-section padding="20px 16px" background-color="#03070d">
            <mj-column css-class="inquiry-surface" background-color="#02050a" padding="0">
                <mj-table
                    css-class="mobile-gutter"
                    cellpadding="0"
                    cellspacing="0"
                    padding="28px 36px 0"
                    width="100%"
                >
                    <tr>
                        <td
                            width="50%"
                            style="
                                padding: 0 18px 10px 0;
                                color: #f2f5f8;
                                font-size: 11px;
                                font-weight: 400;
                                letter-spacing: 2px;
                                line-height: 16px;
                                text-transform: uppercase;
                            "
                        >
                            New inquiry
                        </td>
                        <td
                            align="right"
                            width="50%"
                            style="
                                padding: 0 0 10px;
                                color: #8f98a5;
                                font-size: 10px;
                                font-weight: 400;
                                letter-spacing: 1.4px;
                                line-height: 16px;
                                text-transform: uppercase;
                            "
                        >
                            nowakkamil.com
                        </td>
                    </tr>
                    <tr>
                        <td
                            colspan="2"
                            bgcolor="#2b3541"
                            height="1"
                            style="
                                height: 1px;
                                font-size: 0;
                                line-height: 0;
                                mso-line-height-rule: exactly;
                            "
                        >
                            &nbsp;
                        </td>
                    </tr>
                </mj-table>

                <mj-text
                    css-class="mobile-gutter inquiry-name"
                    color="#f2f5f8"
                    font-size="28px"
                    font-weight="400"
                    letter-spacing="-0.5px"
                    line-height="34px"
                    padding="32px 36px 2px"
                >
                    {{ customerName }}
                </mj-text>

                <mj-text
                    css-class="mobile-gutter inquiry-email"
                    color="#159bb0"
                    font-size="13px"
                    font-weight="400"
                    line-height="20px"
                    padding="0 36px 26px"
                >
                    <a href="mailto:{{ customerEmail }}">{{ customerEmail }}</a>
                </mj-text>

                <mj-text
                    css-class="mobile-gutter"
                    color="#8f98a5"
                    font-size="10px"
                    font-weight="400"
                    letter-spacing="1.5px"
                    line-height="16px"
                    padding="0 36px 10px"
                    text-transform="uppercase"
                >
                    Message
                </mj-text>

                <mj-table
                    css-class="mobile-gutter"
                    cellpadding="0"
                    cellspacing="0"
                    padding="0 36px 34px"
                    width="100%"
                >
                    <tr>
                        <td
                            width="2"
                            bgcolor="#159bb0"
                            style="
                                width: 2px;
                                padding: 0;
                                background-color: #159bb0;
                                font-size: 0;
                                line-height: 0;
                            "
                        >
                            &nbsp;
                        </td>
                        <td
                            bgcolor="#050c14"
                            style="
                                padding: 14px 16px;
                                background-color: #050c14;
                                color: #dfe6ed;
                                font-size: 15px;
                                font-weight: 400;
                                line-height: 25px;
                            "
                        >
                            {{ message }}
                        </td>
                    </tr>
                </mj-table>
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
