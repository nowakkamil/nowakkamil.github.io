<mjml lang="en" dir="ltr">
    <mj-head>
        <mj-title>New inquiry — nowakkamil.com</mj-title>
        <mj-preview>New portfolio inquiry from {{ customerName }}</mj-preview>
        <mj-attributes>
            <mj-all
                font-family="'Avenir Next', Avenir, 'Segoe UI', Helvetica, sans-serif"
                font-weight="400"
            />
            <mj-text color="#dce6f2" font-size="19px" line-height="32px" />
            <mj-section padding="0" />
            <mj-column padding="0" />
        </mj-attributes>
        <mj-style inline="inline">
            body {
                overflow-x: hidden !important;
            }
            .inquiry-surface {
                width: 100% !important;
                box-sizing: border-box !important;
                border: 1px solid #1c2331 !important;
                border-radius: 12px !important;
                background-color: #00040e !important;
                background-clip: padding-box !important;
                overflow: hidden !important;
            }
            .inquiry-surface > table {
                width: 100% !important;
                table-layout: fixed !important;
                background-color: #00040e !important;
                border-collapse: separate !important;
                border-spacing: 0 !important;
                border-radius: 11px !important;
                overflow: hidden !important;
            }
            .header-rule {
                background-image: linear-gradient(90deg, #7f9cbc 0%, #56698c 42%, #2b3652 100%);
            }
            .inquiry-email a {
                color: #53a4ff !important;
                text-decoration: none !important;
                -webkit-text-fill-color: #53a4ff !important;
            }
        </mj-style>
        <mj-style>
            /* This email is dark in every theme. Telling the client so stops
               Apple Mail and Outlook from re-tinting it in either direction. */
            :root {
                color-scheme: dark;
                supported-color-schemes: dark;
            }
            /* Outlook.com rewrites colours in dark mode and exposes these hooks
               so the original palette can be restored. */
            [data-ogsc] .email-canvas {
                background-color: #00030c !important;
            }
            [data-ogsc] .inquiry-surface,
            [data-ogsc] .inquiry-surface > table {
                background-color: #00040e !important;
            }
            [data-ogsc] .inquiry-quote {
                background-color: #020a17 !important;
                color: #f2f6fb !important;
            }
            [data-ogsc] .inquiry-email a {
                color: #53a4ff !important;
                -webkit-text-fill-color: #53a4ff !important;
            }
            @media only screen and (max-width: 480px) {
                .mobile-gutter {
                    padding-left: 24px !important;
                    padding-right: 24px !important;
                }
                .inquiry-quote {
                    padding: 18px 16px !important;
                    font-size: 17px !important;
                    line-height: 28px !important;
                }
                .inquiry-name {
                    padding-top: 30px !important;
                    font-size: 33px !important;
                    line-height: 40px !important;
                }
            }
        </mj-style>
        <mj-raw
            ><meta name="color-scheme" content="dark" /> <meta name="supported-color-schemes"
            content="dark" /></mj-raw
        >
    </mj-head>
    <mj-body width="680px" background-color="#00030c">
        <mj-section
            css-class="email-canvas"
            full-width="full-width"
            padding="14px"
            background-color="#00030c"
        >
            <mj-column
                css-class="inquiry-surface"
                background-color="#00040e"
                border="1px solid #1c2331"
                border-radius="12px"
                padding="0"
            >
                <mj-table
                    css-class="mobile-gutter"
                    cellpadding="0"
                    cellspacing="0"
                    padding="38px 44px 0"
                    width="100%"
                >
                    <tr>
                        <td
                            width="50%"
                            style="
                                padding: 0 18px 15px 0;
                                color: #b9dcff;
                                font-size: 14px;
                                font-weight: 600;
                                letter-spacing: 3px;
                                line-height: 20px;
                                text-transform: uppercase;
                            "
                        >
                            New inquiry
                        </td>
                        <td
                            align="right"
                            width="50%"
                            style="
                                padding: 0 0 15px;
                                color: #eef5fd;
                                font-size: 12px;
                                font-weight: 500;
                                letter-spacing: 2.4px;
                                line-height: 20px;
                                text-transform: uppercase;
                            "
                        >
                            nowakkamil.com
                        </td>
                    </tr>
                    <tr>
                        <td
                            class="header-rule"
                            colspan="2"
                            bgcolor="#4f6787"
                            height="1"
                            style="
                                height: 1px;
                                background-color: #4f6787;
                                font-size: 0;
                                line-height: 0;
                                mso-line-height-rule: exactly;
                            "
                        >
                            &nbsp;
                        </td>
                    </tr>
                </mj-table>
                <mj-text
                    css-class="mobile-gutter inquiry-name"
                    color="#f6f8fb"
                    font-size="42px"
                    font-weight="700"
                    letter-spacing="-0.9px"
                    line-height="50px"
                    padding="40px 44px 6px"
                    >{{ customerName }}</mj-text
                >
                <mj-text
                    css-class="mobile-gutter inquiry-email"
                    color="#53a4ff"
                    font-size="16px"
                    font-weight="500"
                    line-height="26px"
                    padding="0 44px 32px"
                    ><a href="mailto:{{ customerEmail }}">{{ customerEmail }}</a></mj-text
                >
                <mj-text
                    css-class="mobile-gutter"
                    color="#b9dcff"
                    font-size="13px"
                    font-weight="600"
                    letter-spacing="2.4px"
                    line-height="20px"
                    padding="0 44px 14px"
                    text-transform="uppercase"
                    >Message</mj-text
                >
                <mj-table
                    css-class="mobile-gutter"
                    cellpadding="0"
                    cellspacing="0"
                    padding="0 44px 44px"
                    width="100%"
                >
                    <tr>
                        <td
                            class="inquiry-quote"
                            bgcolor="#020a17"
                            style="
                                padding: 29px;
                                border: 1px solid #14355a;
                                border-left: 4px solid #63acf5;
                                border-radius: 6px;
                                background-color: #020a17;
                                color: #f2f6fb;
                                font-size: 18px;
                                font-weight: 400;
                                line-height: 30px;
                                overflow-wrap: anywhere;
                                word-break: break-word;
                                word-wrap: break-word;
                            "
                        >
                            {{ message }}
                        </td>
                    </tr>
                </mj-table>
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
