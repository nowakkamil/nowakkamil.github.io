<mjml lang="en" dir="ltr">
    <mj-head>
        <mj-title>Kamil Nowak — Customer message</mj-title>
        <mj-preview>A personal note from Kamil Nowak about your message.</mj-preview>

        <mj-attributes>
            <mj-all
                font-family="'Avenir Next', Avenir, 'Segoe UI', Helvetica, sans-serif"
                font-weight="400"
            />
            <mj-text color="#d9dee5" font-size="15px" line-height="26px" />
            <mj-section padding="0" />
            <mj-column padding="0" />
        </mj-attributes>

        <mj-style inline="inline">
            body {
                overflow-x: hidden !important;
            }

            .contact-surface {
                width: 100% !important;
                box-sizing: border-box !important;
                background-color: #02050a !important;
            }

            .contact-surface > table {
                width: 100% !important;
                table-layout: fixed !important;
                background-color: #02050a !important;
            }

            .message-copy p {
                margin-top: 0;
            }

            .message-copy blockquote {
                border-left-color: #159bb0 !important;
                background-color: #050c14 !important;
                color: #dfe6ed !important;
                font-style: normal !important;
                font-weight: 400 !important;
            }

            .portfolio-link a,
            .email-signature a {
                color: #d9dee5 !important;
                text-decoration: none !important;
                -webkit-text-fill-color: #d9dee5 !important;
            }
        </mj-style>

        <mj-style>
            /* SIGNATURE_STYLES */

            .email-signature > table {
                width: 100% !important;
                max-width: 100% !important;
            }

            @media only screen and (max-width: 480px) {
                .mobile-gutter {
                    padding-left: 24px !important;
                    padding-right: 24px !important;
                }

                .email-greeting {
                    padding-top: 24px !important;
                    font-size: 26px !important;
                }

                .email-signature .kn-email-signature-frame {
                    padding: 24px !important;
                }
            }
        </mj-style>

        <mj-raw>
            <meta name="color-scheme" content="dark" /> <meta name="supported-color-schemes"
            content="dark" />
        </mj-raw>
    </mj-head>

    <mj-body width="632px" background-color="#03070d">
        <mj-section padding="20px 16px" background-color="#03070d">
            <mj-column css-class="contact-surface" background-color="#02050a" padding="0">
                <mj-table
                    css-class="mobile-gutter"
                    cellpadding="0"
                    cellspacing="0"
                    padding="28px 36px 0"
                    role="presentation"
                    width="100%"
                >
                    <tr>
                        <td
                            width="50%"
                            style="
                                padding: 0 18px 10px 0;
                                color: #f2f5f8;
                                font-family:
                                    'Avenir Next', Avenir, 'Segoe UI', Helvetica, sans-serif;
                                font-size: 11px;
                                font-weight: 400;
                                letter-spacing: 2px;
                                line-height: 16px;
                                text-transform: uppercase;
                            "
                        >
                            Message
                        </td>
                        <td
                            class="portfolio-link"
                            align="right"
                            width="50%"
                            style="
                                padding: 0 0 10px;
                                color: #8f98a5;
                                font-family:
                                    'Avenir Next', Avenir, 'Segoe UI', Helvetica, sans-serif;
                                font-size: 10px;
                                font-weight: 400;
                                letter-spacing: 1.4px;
                                line-height: 16px;
                                text-transform: uppercase;
                            "
                        >
                            <a href="https://nowakkamil.com" target="_blank">nowakkamil.com</a>
                        </td>
                    </tr>
                    <tr>
                        <td
                            colspan="2"
                            bgcolor="#2b3541"
                            height="1"
                            style="font-size: 0; line-height: 0"
                        >
                            &nbsp;
                        </td>
                    </tr>
                </mj-table>

                <mj-text
                    css-class="mobile-gutter email-greeting"
                    color="#f2f5f8"
                    font-size="28px"
                    font-weight="400"
                    letter-spacing="-0.6px"
                    line-height="34px"
                    padding="32px 36px 8px"
                >
                    Hi {{ firstName }},
                </mj-text>

                <mj-text
                    css-class="mobile-gutter message-copy"
                    color="#cdd3da"
                    font-size="15px"
                    font-weight="400"
                    line-height="26px"
                    padding="8px 36px 32px"
                >
                    {{ message }}
                </mj-text>

                <mj-divider
                    border-color="#2b3541"
                    border-style="solid"
                    border-width="1px"
                    padding="0 36px"
                />
                <mj-table
                    cellpadding="0"
                    cellspacing="0"
                    padding="0"
                    role="presentation"
                    width="100%"
                >
                    <tr>
                        <td style="padding: 0">
                            <div class="email-signature">
                                <!-- SIGNATURE_HTML -->
                            </div>
                        </td>
                    </tr>
                </mj-table>
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
