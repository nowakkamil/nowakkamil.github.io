<mjml lang="en" dir="ltr">
    <mj-head>
        <mj-title>Kamil Nowak — Customer message</mj-title>
        <mj-preview>A personal note from Kamil Nowak about your message.</mj-preview>
        <mj-attributes>
            <mj-all
                font-family="'Avenir Next', Avenir, 'Segoe UI', Helvetica, sans-serif"
                font-weight="400"
            />
            <mj-text color="#dce6f2" font-size="19px" line-height="32px" />
            <mj-section padding="0" />
            <mj-column padding="0" />
        </mj-attributes>
        <mj-style inline="inline">
            body {
                overflow-x: hidden !important;
            }
            .contact-surface {
                width: 100% !important;
                box-sizing: border-box !important;
                border: 0 !important;
                border-radius: 12px !important;
                background-color: #00040e !important;
                background-clip: padding-box !important;
                overflow: hidden !important;
            }
            .contact-surface > table {
                width: 100% !important;
                table-layout: fixed !important;
                background-color: #00040e !important;
                border-collapse: separate !important;
                border-spacing: 0 !important;
                border-radius: 11px !important;
                overflow: hidden !important;
            }
            .message-copy p {
                margin-top: 0;
            }
            .header-rule {
                background-image: linear-gradient(90deg, #7f9cbc 0%, #56698c 42%, #2b3652 100%);
            }
            .portfolio-link a,
            .email-signature a {
                color: #eef5fd !important;
                text-decoration: none !important;
                -webkit-text-fill-color: #eef5fd !important;
            }
        </mj-style>
        <mj-style>
            /* SIGNATURE_STYLES */
            .email-signature > table {
                width: 100% !important;
                max-width: 100% !important;
            }
            /* This email is dark in every theme. Telling the client so stops
               Apple Mail and Outlook from re-tinting it in either direction. */
            :root {
                color-scheme: dark;
                supported-color-schemes: dark;
            }
            /* Outlook.com rewrites colours in dark mode and exposes these hooks
               so the original palette can be restored. */
            [data-ogsc] .email-canvas {
                background-color: #00030c !important;
            }
            [data-ogsc] .contact-surface,
            [data-ogsc] .contact-surface > table,
            [data-ogsc] .email-signature > table,
            [data-ogsc] .kn-email-signature-frame {
                background-color: #00040e !important;
            }
            [data-ogsc] .email-greeting {
                color: #f6f8fb !important;
            }
            [data-ogsc] .message-copy,
            [data-ogsc] .message-copy p {
                color: #dce6f2 !important;
            }
            [data-ogsc] .message-quote-content {
                color: #f2f6fb !important;
            }
            [data-ogsc] .message-quote {
                background-color: #14355a !important;
            }
            [data-ogsc] .message-quote-panel {
                background-color: #020a17 !important;
            }
            [data-ogsc] .message-quote-accent {
                background-color: #63acf5 !important;
            }
            [data-ogsc] .portfolio-link a,
            [data-ogsc] .email-signature a,
            [data-ogsc] .kn-email-signature-contact-row td {
                color: #eef5fd !important;
                -webkit-text-fill-color: #eef5fd !important;
            }
            @media only screen and (max-width: 600px) {
                .email-eyebrow {
                    font-size: 12px !important;
                }
                .portfolio-link {
                    font-size: 11px !important;
                    letter-spacing: 2px !important;
                }
                .email-greeting div {
                    font-size: 40px !important;
                    line-height: 48px !important;
                }
                .message-copy p {
                    font-size: 17px !important;
                    line-height: 28px !important;
                }
            }
            @media only screen and (max-width: 480px) {
                .mobile-gutter {
                    padding-left: 24px !important;
                    padding-right: 24px !important;
                }
                .email-greeting {
                    padding-top: 32px !important;
                }
                .email-greeting div {
                    font-size: 36px !important;
                    line-height: 44px !important;
                }
                /* Outranks the signature's own rule, so it has to restate the
                   percentage that keeps the wave below the last contact row. */
                .email-signature .kn-email-signature-frame {
                    padding-top: 26px !important;
                    padding-left: 24px !important;
                    padding-right: 24px !important;
                }
                .message-quote-accent {
                    display: block !important;
                    width: 100% !important;
                    height: 2px !important;
                }
                .message-quote-opening {
                    display: block !important;
                    width: auto !important;
                    padding: 16px 16px 0 !important;
                    font-size: 38px !important;
                    line-height: 34px !important;
                }
                .message-quote-content {
                    display: block !important;
                    padding: 10px 16px !important;
                    font-size: 17px !important;
                    line-height: 28px !important;
                }
                .message-quote-closing {
                    display: block !important;
                    width: auto !important;
                    padding: 0 16px 16px !important;
                    font-size: 38px !important;
                    line-height: 34px !important;
                }
            }
        </mj-style>
        <mj-raw
            ><meta name="color-scheme" content="dark" /> <meta name="supported-color-schemes"
            content="dark" /></mj-raw
        >
    </mj-head>
    <mj-body width="680px" background-color="#00030c">
        <mj-section
            css-class="email-canvas"
            full-width="full-width"
            padding="14px"
            background-color="#00030c"
        >
            <mj-column
                css-class="contact-surface"
                background-color="#00040e"
                border="none"
                border-radius="12px"
                padding="0"
            >
                <mj-table
                    css-class="mobile-gutter"
                    cellpadding="0"
                    cellspacing="0"
                    padding="38px 44px 0"
                    width="100%"
                >
                    <tr>
                        <td
                            class="email-eyebrow"
                            width="50%"
                            style="
                                padding: 0 18px 15px 0;
                                color: #b9dcff;
                                font-size: 14px;
                                font-weight: 600;
                                letter-spacing: 3px;
                                line-height: 20px;
                                text-transform: uppercase;
                            "
                        >
                            Message
                        </td>
                        <td
                            class="portfolio-link"
                            align="right"
                            width="50%"
                            style="
                                padding: 0 0 15px;
                                color: #eef5fd;
                                font-size: 12px;
                                font-weight: 500;
                                letter-spacing: 2.4px;
                                line-height: 20px;
                                text-transform: uppercase;
                            "
                        >
                            <a href="https://nowakkamil.com" target="_blank">nowakkamil.com</a>
                        </td>
                    </tr>
                    <tr>
                        <td
                            class="header-rule"
                            colspan="2"
                            bgcolor="#4f6787"
                            height="1"
                            style="
                                height: 1px;
                                background-color: #4f6787;
                                font-size: 0;
                                line-height: 0;
                                mso-line-height-rule: exactly;
                            "
                        >
                            &nbsp;
                        </td>
                    </tr>
                </mj-table>
                <mj-text
                    css-class="mobile-gutter email-greeting"
                    color="#f6f8fb"
                    font-size="46px"
                    font-weight="500"
                    letter-spacing="-1px"
                    line-height="54px"
                    padding="40px 44px 12px"
                    >Hi {{ firstName }},</mj-text
                >
                <mj-text
                    css-class="mobile-gutter message-copy"
                    color="#dce6f2"
                    font-size="19px"
                    font-weight="400"
                    line-height="32px"
                    padding="0 44px 21px"
                    >{{ message }}</mj-text
                >
                <mj-table
                    css-class="mobile-gutter"
                    cellpadding="0"
                    cellspacing="0"
                    padding="0 44px"
                    width="100%"
                >
                    <tr>
                        <td
                            bgcolor="#1a2238"
                            height="1"
                            style="
                                height: 1px;
                                background-color: #1a2238;
                                font-size: 0;
                                line-height: 0;
                                mso-line-height-rule: exactly;
                            "
                        >
                            &nbsp;
                        </td>
                    </tr>
                </mj-table>
                <mj-table cellpadding="0" cellspacing="0" padding="0" width="100%"
                    ><tr>
                        <td style="padding: 0">
                            <div class="email-signature"><!-- SIGNATURE_HTML --></div>
                        </td>
                    </tr></mj-table
                >
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
