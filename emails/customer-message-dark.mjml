<mjml lang="en" dir="ltr">
    <mj-head>
        <mj-title>Kamil Nowak — Customer message</mj-title>
        <mj-preview>A personal note from Kamil Nowak about your message.</mj-preview>

        <mj-attributes>
            <mj-all
                font-family="'Avenir Next', Avenir, 'Segoe UI', Helvetica, sans-serif"
                font-weight="400"
            />
            <mj-text color="#d9dee5" font-size="15px" line-height="1.72" />
            <mj-section padding="0" />
            <mj-column padding="0" />
        </mj-attributes>

        <mj-style inline="inline">
            body {
                overflow-x: hidden !important;
            }

            .contact-surface {
                width: 100% !important;
                box-sizing: border-box !important;
                background-color: #02050a !important;
            }

            .contact-surface > table {
                width: 100% !important;
                table-layout: fixed !important;
                background-color: #02050a !important;
            }

            .message-copy p {
                margin-top: 0;
            }

            .message-copy blockquote {
                border-left-color: #159bb0 !important;
                background-color: #050c14 !important;
                color: #dfe6ed !important;
                font-style: normal !important;
                font-weight: 400 !important;
            }

            .email-margin {
                height: 20px !important;
                line-height: 20px !important;
            }

            .portfolio-link a,
            .email-signature a {
                color: #d9dee5 !important;
                text-decoration: none !important;
                -webkit-text-fill-color: #d9dee5 !important;
            }
        </mj-style>

        <mj-style>
            /* SIGNATURE_STYLES */

            .email-signature > table {
                width: 100% !important;
                max-width: 100% !important;
            }

            .email-signature .kn-signature-frame {
                padding: 28px 36px 32px !important;
            }

            .email-signature .kn-signature-name {
                color: #f2f5f8 !important;
                font-weight: 400 !important;
            }

            .email-signature .kn-signature-role {
                color: #159bb0 !important;
                font-weight: 400 !important;
            }

            .email-signature .kn-signature-description {
                color: #bfc6cf !important;
                font-weight: 400 !important;
            }

            .email-signature .kn-signature-divider-line {
                background-color: #2b3541 !important;
            }

            .email-signature .kn-signature-contact-table,
            .email-signature .kn-signature-contact-table > tbody,
            .email-signature .kn-signature-contact-row {
                display: block !important;
                width: 100% !important;
            }

            .email-signature .kn-signature-contact-item {
                display: block !important;
                width: 100% !important;
                box-sizing: border-box !important;
                padding: 8px 0 !important;
                border-top: 1px solid #2b3541 !important;
                border-left: 0 !important;
                color: #d9dee5 !important;
                font-weight: 400 !important;
            }

            @media only screen and (max-width: 600px) {
                .email-signature .kn-signature-divider {
                    display: none !important;
                }
            }

            @media only screen and (max-width: 480px) {
                .mobile-gutter {
                    padding-left: 24px !important;
                    padding-right: 24px !important;
                }

                .email-margin {
                    height: 12px !important;
                    line-height: 12px !important;
                }

                .email-greeting {
                    padding-top: 24px !important;
                    font-size: 26px !important;
                }

                .email-signature .kn-signature-frame {
                    padding: 24px !important;
                }

                .email-signature .kn-signature-monogram-cell,
                .email-signature .kn-signature-content-cell {
                    display: block !important;
                    width: 100% !important;
                }

                .email-signature .kn-signature-monogram-cell {
                    padding: 0 0 14px !important;
                    border-right: 0 !important;
                    text-align: center !important;
                }

                .email-signature .kn-signature-content-cell {
                    padding-left: 0 !important;
                }

                .email-signature .kn-signature-monogram-image {
                    width: 74px !important;
                    height: 74px !important;
                    margin: 0 auto !important;
                }

                .email-signature .kn-signature-identity {
                    text-align: center !important;
                }
            }
        </mj-style>

        <mj-raw>
            <meta name="color-scheme" content="dark" /> <meta name="supported-color-schemes"
            content="dark" />
        </mj-raw>
    </mj-head>

    <mj-body width="600px" background-color="#03070d">
        <mj-section padding="0" background-color="#03070d">
            <mj-column>
                <mj-spacer css-class="email-margin" height="20px" />
            </mj-column>
        </mj-section>

        <mj-wrapper
            css-class="contact-surface"
            background-color="#02050a"
            border="1px solid #161f29"
            padding="0"
        >
            <mj-section background-color="#02050a">
                <mj-column>
                    <mj-table
                        css-class="mobile-gutter"
                        cellpadding="0"
                        cellspacing="0"
                        padding="28px 36px 0"
                        role="presentation"
                        width="100%"
                    >
                        <tr>
                            <td
                                width="50%"
                                style="
                                    padding: 0 18px 10px 0;
                                    color: #f2f5f8;
                                    font-family:
                                        'Avenir Next', Avenir, 'Segoe UI', Helvetica, sans-serif;
                                    font-size: 11px;
                                    font-weight: 400;
                                    letter-spacing: 2px;
                                    line-height: 16px;
                                    text-transform: uppercase;
                                "
                            >
                                Message
                            </td>
                            <td
                                class="portfolio-link"
                                align="right"
                                width="50%"
                                style="
                                    padding: 0 0 10px;
                                    color: #8f98a5;
                                    font-family:
                                        'Avenir Next', Avenir, 'Segoe UI', Helvetica, sans-serif;
                                    font-size: 10px;
                                    font-weight: 400;
                                    letter-spacing: 1.4px;
                                    line-height: 16px;
                                    text-transform: uppercase;
                                "
                            >
                                <a href="https://nowakkamil.com" target="_blank">nowakkamil.com</a>
                            </td>
                        </tr>
                        <tr>
                            <td
                                colspan="2"
                                bgcolor="#2b3541"
                                height="1"
                                style="font-size: 0; line-height: 0"
                            >
                                &nbsp;
                            </td>
                        </tr>
                    </mj-table>

                    <mj-text
                        css-class="mobile-gutter email-greeting"
                        color="#f2f5f8"
                        font-size="28px"
                        font-weight="400"
                        letter-spacing="-0.6px"
                        line-height="1.2"
                        padding="32px 36px 8px"
                    >
                        Hi {{ firstName }},
                    </mj-text>

                    <mj-text
                        css-class="mobile-gutter message-copy"
                        color="#cdd3da"
                        font-size="15px"
                        font-weight="400"
                        line-height="1.72"
                        padding="8px 36px 32px"
                    >
                        {{ message }}
                    </mj-text>

                    <mj-divider
                        border-color="#2b3541"
                        border-style="solid"
                        border-width="1px"
                        padding="0 36px"
                    />
                </mj-column>
            </mj-section>

            <mj-section background-color="#02050a">
                <mj-column>
                    <mj-table
                        cellpadding="0"
                        cellspacing="0"
                        padding="0"
                        role="presentation"
                        width="100%"
                    >
                        <tr>
                            <td style="padding: 0">
                                <div class="email-signature">
                                    <!-- SIGNATURE_HTML -->
                                </div>
                            </td>
                        </tr>
                    </mj-table>
                </mj-column>
            </mj-section>
        </mj-wrapper>

        <mj-section padding="0" background-color="#03070d">
            <mj-column>
                <mj-spacer css-class="email-margin" height="20px" />
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
