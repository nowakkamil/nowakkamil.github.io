<mjml lang="en" dir="ltr">
    <mj-head>
        <mj-title>Kamil Nowak — Customer message</mj-title>
        <mj-preview>A personal note from Kamil Nowak about your message.</mj-preview>
        <mj-attributes>
            <mj-all
                font-family="'Avenir Next', Avenir, 'Segoe UI', Helvetica, sans-serif"
                font-weight="400"
            />
            <mj-text color="#dce6f2" font-size="16px" line-height="28px" />
            <mj-section padding="0" />
            <mj-column padding="0" />
        </mj-attributes>
        <mj-style inline="inline">
            body {
                overflow-x: hidden !important;
            }
            .contact-surface {
                width: 100% !important;
                box-sizing: border-box !important;
                border: 1px solid #192b42 !important;
                border-radius: 7px !important;
                background-color: #030a18 !important;
            }
            .contact-surface > table {
                width: 100% !important;
                table-layout: fixed !important;
                background-color: #030a18 !important;
                border-radius: 7px !important;
            }
            .message-copy p {
                margin-top: 0;
            }
            .portfolio-link a,
            .email-signature a {
                color: #eef5fd !important;
                text-decoration: none !important;
                -webkit-text-fill-color: #eef5fd !important;
            }
        </mj-style>
        <mj-style>
            /* SIGNATURE_STYLES */
            .email-signature > table {
                width: 100% !important;
                max-width: 100% !important;
            }
            @media only screen and (max-width: 480px) {
                .mobile-gutter {
                    padding-left: 24px !important;
                    padding-right: 24px !important;
                }
                .email-greeting {
                    padding-top: 30px !important;
                    font-size: 31px !important;
                    line-height: 38px !important;
                }
                .email-signature .kn-email-signature-frame {
                    padding: 26px 24px 8px !important;
                }
            }
        </mj-style>
        <mj-raw
            ><meta name="color-scheme" content="dark" /> <meta name="supported-color-schemes"
            content="dark" /></mj-raw
        >
    </mj-head>
    <mj-body width="680px" background-color="#010611">
        <mj-section padding="20px 16px" background-color="#010611">
            <mj-column css-class="contact-surface" background-color="#030a18" padding="0">
                <mj-table
                    css-class="mobile-gutter"
                    cellpadding="0"
                    cellspacing="0"
                    padding="36px 42px 0"
                    width="100%"
                >
                    <tr>
                        <td
                            width="50%"
                            style="
                                padding: 0 18px 14px 0;
                                color: #b9dcff;
                                font-size: 12px;
                                font-weight: 600;
                                letter-spacing: 3px;
                                line-height: 18px;
                                text-transform: uppercase;
                            "
                        >
                            Message
                        </td>
                        <td
                            class="portfolio-link"
                            align="right"
                            width="50%"
                            style="
                                padding: 0 0 14px;
                                color: #eef5fd;
                                font-size: 11px;
                                font-weight: 500;
                                letter-spacing: 2.2px;
                                line-height: 18px;
                                text-transform: uppercase;
                            "
                        >
                            <a href="https://nowakkamil.com" target="_blank">nowakkamil.com</a>
                        </td>
                    </tr>
                    <tr>
                        <td
                            colspan="2"
                            bgcolor="#4f8fca"
                            height="1"
                            style="
                                height: 1px;
                                background-color: #4f8fca;
                                font-size: 0;
                                line-height: 0;
                                mso-line-height-rule: exactly;
                            "
                        >
                            &nbsp;
                        </td>
                    </tr>
                </mj-table>
                <mj-text
                    css-class="mobile-gutter email-greeting"
                    color="#f6f8fb"
                    font-size="38px"
                    font-weight="600"
                    letter-spacing="-1px"
                    line-height="46px"
                    padding="40px 42px 10px"
                    >Hi {{ firstName }},</mj-text
                >
                <mj-text
                    css-class="mobile-gutter message-copy"
                    color="#dce6f2"
                    font-size="17px"
                    font-weight="400"
                    line-height="29px"
                    padding="10px 42px 36px"
                    >{{ message }}</mj-text
                >
                <mj-table
                    css-class="mobile-gutter"
                    cellpadding="0"
                    cellspacing="0"
                    padding="0 42px"
                    width="100%"
                >
                    <tr>
                        <td
                            bgcolor="#263d5a"
                            height="1"
                            style="
                                height: 1px;
                                background-color: #263d5a;
                                font-size: 0;
                                line-height: 0;
                                mso-line-height-rule: exactly;
                            "
                        >
                            &nbsp;
                        </td>
                    </tr>
                </mj-table>
                <mj-table cellpadding="0" cellspacing="0" padding="0" width="100%"
                    ><tr>
                        <td style="padding: 0">
                            <div class="email-signature"><!-- SIGNATURE_HTML --></div>
                        </td>
                    </tr></mj-table
                >
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
