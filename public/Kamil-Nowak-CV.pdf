               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>[MAIN] Full-stack web development while guiding a team of passionate s</photoshop:LayerName>
                  <photoshop:LayerText>Full-stack web development while guiding a team of passionate students. Technologies: HTML, CSS, JavaScript, ASP.NET Core (MVC), Microsoft SQL Server, Entity Framework Core</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>[MAIN BOLD] Leader of C# .NET Students Scientific Association</photoshop:LayerName>
